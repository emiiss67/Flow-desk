[Unit]
Description=FlowDesk desk API (127.0.0.1 only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grokbot
WorkingDirectory=/home/grokbot/flowdesk
EnvironmentFile=/home/grokbot/flowdesk/.env
ExecStart=/home/grokbot/flowdesk/venv/bin/python -m flowdesk.api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
