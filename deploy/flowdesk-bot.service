[Unit]
Description=FlowDesk paper-trading bot (scanner + Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grokbot
WorkingDirectory=/home/grokbot/flowdesk
EnvironmentFile=/home/grokbot/flowdesk/.env
ExecStart=/home/grokbot/flowdesk/venv/bin/python -m flowdesk.bot
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
