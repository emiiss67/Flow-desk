# Copy to .env and fill in. Never commit .env.
FLOWDESK_TELEGRAM_TOKEN=
FLOWDESK_TELEGRAM_CHAT_ID=
# Optional: OANDA practice (fxTrade Practice) for live FX/CFD prices. Data only - no orders are sent.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
# Optional overrides
FLOWDESK_CONFIG=config.yaml
FLOWDESK_DATA_DIR=data
# FLOWDESK_API_PORT=8795   # if 8790 is already used on the host
# FLOWDESK_CLOUDFLARED=/usr/local/bin/cloudflared
