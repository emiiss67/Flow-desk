# Copy to .env on the server. Never commit the real file.
# Telegram bot token from @BotFather.
FLOWDESK_TELEGRAM_TOKEN=
# Your private chat id. Leave empty on first boot and run:
#   python -m flowdesk.discover_chat
# or send /start to the bot before anyone else does.
FLOWDESK_TELEGRAM_CHAT_ID=
# Optional. Both must be set to enable the OANDA practice price feed.
# Practice only — FlowDesk never sends broker orders.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# Optional path to the YAML config. Defaults to ./config.yaml.
FLOWDESK_CONFIG=config.yaml
